# ============================================================
# OFF PITCH AFRICA — environment variables (TEMPLATE)
# ------------------------------------------------------------
# Copy this file to `.env` and fill in your real values:
#
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is gitignored — it is NEVER committed and NEVER deployed.
# These variables are read automatically when you run the site
# locally with `vercel dev` (`npm run dev`).
#
# For the LIVE site, the same variables must be set in the Vercel
# dashboard (Project → Settings → Environment Variables) — see
# README.md section 7 — or pushed with `vercel env add`.
# ============================================================

# --- Admin dashboard (required for /admin.html) ---

# The password you type to log into /admin.html.
ADMIN_PASSWORD=

# Long random string used to sign login sessions. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Fine-grained GitHub Personal Access Token, scoped ONLY to this
# repo with "Contents: Read and write". Used server-side to commit
# content changes from the dashboard.
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# --- AI chat assistant + admin "✨ Suggest" buttons (optional) ---

# Anthropic API key from console.anthropic.com.
# Needs billing/credit active for the assistant to respond.
ANTHROPIC_API_KEY=

# --- Social feed / live-stream banner (optional) ---

# YouTube Data API v3 key from console.cloud.google.com.
YOUTUBE_API_KEY=

# Off Pitch Africa's channel ID — optional, the code already defaults
# to the real channel, only set this if the channel ever changes.
# YOUTUBE_CHANNEL_ID=UC9KSYu8ggh9TSEtn8PSYj1A

# Instagram long-lived access token (Business/Creator account).
IG_ACCESS_TOKEN=

# Facebook Page ID + Page access token (pages_read_engagement).
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
